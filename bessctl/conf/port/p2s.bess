dpdk_ports = int($BESS_PORTS!'1')
print('Using %d DPDK ports... (envvar "BESS_PORTS")' % dpdk_ports)

for i in range(dpdk_ports):
    p = PMDPort(port_id=i)
    PortInc(port=p.name) -> Sink()
