if get_option('build_tests')
  # The wrapper itself, by bytes (tools/run_capped.py --self-test): a process
  # that touches more than its declaration fails, the same one under it
  # passes.
  mem_hog = executable('mem_hog', 'mem_hog.cc')
  test(
    'run_capped_self_test',
    python,
    args: [files('../../tools/run_capped.py'), '--self-test', mem_hog.full_path()],
    depends: mem_hog,
    env: {'BESS_TEST_MEM_MB': test_memory_mb.get('run_capped_self_test', 0).to_string()},
    is_parallel: false,
    suite: 'architecture',
  )
endif
